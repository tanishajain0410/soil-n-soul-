PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PGSSL=enable
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=https://www.soilnsoultravels.com,https://soilnsoultravels.com
NODE_ENV=production
SITE_URL=https://www.soilnsoultravels.com

# One-time MongoDB import only; not used by the running API.
MONGODB_MIGRATION_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority

# Optional when creating a new admin with `npm run seed`.
ADMIN_NAME=SoilNSoul Travels Admin
ADMIN_EMAIL=admin@soilnsoul.in
ADMIN_PASSWORD=replace_with_a_secure_password
